#include <windows.h>
#include "Version.h"

// Embed Application Icon (ID 1 is used as primary executable icon by Windows Explorer)
1 ICON "../assets/app.ico"

// Embed Application Manifest
1 24 "app.manifest"

// Embed Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION_RC
PRODUCTVERSION  APP_VERSION_RC
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      APP_TEAM "\0"
            VALUE "FileDescription",  APP_DESC "\0"
            VALUE "FileVersion",      APP_VERSION_STRING "\0"
            VALUE "InternalName",     APP_NAME "\0"
            VALUE "LegalCopyright",   APP_COPYRIGHT_RC "\0"
            VALUE "LegalTrademarks",  "MIT License\0"
            VALUE "OriginalFilename", APP_EXE_NAME "\0"
            VALUE "ProductName",      APP_NAME "\0"
            VALUE "ProductVersion",   APP_VERSION_STRING "\0"
            VALUE "Comments",         "Licensed under the MIT License. " APP_TEAM " (" APP_WEBSITE ")\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
