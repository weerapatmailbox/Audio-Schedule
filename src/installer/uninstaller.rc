#include <windows.h>
#include "../Version.h"

1 ICON "../../assets/app.ico"
1 24 "../app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     APP_VERSION_RC
PRODUCTVERSION  APP_VERSION_RC
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      APP_AUTHOR " (" APP_TEAM ")\0"
            VALUE "FileDescription",  "Audio Schedule Uninstaller\0"
            VALUE "FileVersion",      APP_VERSION_STRING "\0"
            VALUE "InternalName",     "Uninstall\0"
            VALUE "LegalCopyright",   APP_COPYRIGHT_RC "\0"
            VALUE "OriginalFilename", "Uninstall.exe\0"
            VALUE "ProductName",      APP_NAME "\0"
            VALUE "ProductVersion",   APP_VERSION_STRING "\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
